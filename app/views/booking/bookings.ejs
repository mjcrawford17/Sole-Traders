<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Sole Traders - Bookings</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet"
        integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB" crossorigin="anonymous">
    <link rel="stylesheet" href="/styles/main.css" />
    <link rel="icon" type="image/png" href="/imgs/favicon.png" />
</head>

<body>
    <%- include('../partials/navbar'); %>

        <div class="container-fluid service-container">
            <div class="service-wrapper">
                <div class="service-box">
                    <h2>All Bookings</h2>
                    <% if (!bookings || bookings.length===0) { %>
                        <% if (status) { %>
                            <div class="w-100 d-flex justify-content-end mb-3 filter-wrap">
                                <form class="m-0" method="GET" action="/bookings">

                                    <div class="row filter-bar g-2 align-items-center">

                                        <div class="col-auto">
                                            <select name="status" class="trade-select">
                                                <option value="">Status</option>
                                                <option value="accepted">Confirmed</option>
                                                <option value="pending">Pending</option>
                                                <option value="rejected">Rejected</option>
                                            </select>
                                        </div>

                                        <div class="col-auto">
                                            <button type="submit" class="btn tr-submit-btn">Go</button>
                                        </div>

                                    </div>
                                </form>
                            </div>
                            <p class="text-center text-muted mt-3">
                                No bookings match <%= status %>!
                            </p>
                            <% } else { %>
                                <p class="text-center text-muted mt-3">
                                    No bookings have been made yet. Check again soon!
                                </p>
                                <% } %>
                                    <% } else { %>
                                        <div class="w-100 d-flex justify-content-end mb-3 filter-wrap">
                                            <form class="m-0" method="GET" action="/bookings">

                                                <div class="row filter-bar g-2 align-items-center">

                                                    <div class="col-auto">
                                                        <select name="status" class="trade-select">
                                                            <option value="">Status</option>
                                                            <option value="accepted">Confirmed</option>
                                                            <option value="pending">Pending</option>
                                                            <option value="rejected">Rejected</option>
                                                        </select>
                                                    </div>

                                                    <div class="col-auto">
                                                        <button type="submit" class="btn tr-submit-btn">Go</button>
                                                    </div>

                                                </div>
                                            </form>
                                        </div>
                                        <table class="table">
                                            <thead>
                                                <tr>
                                                    <th scope="col">Client Name</th>
                                                    <th scope="col">Service</th>
                                                    <th scope="col">Location</th>
                                                    <th scope="col">Requested Date</th>
                                                    <th scope="col">Status</th>
                                                    <th scope="col">Actions</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                <% bookings.forEach((row)=> { %>
                                                    <tr>
                                                        <td data-label="Client Name">
                                                            <%= row.client_name %>
                                                        </td>
                                                        <td data-label="Service">
                                                            <%= row.title %>
                                                        </td>
                                                        <td data-label="Location">
                                                            <%= row.job_location %>
                                                        </td>
                                                        <td data-label="Requested Date">
                                                            <time datetime="<%= row.requested_date %>">
                                                                <%= new
                                                                    Date(row.requested_date).toLocaleDateString('en-GB')
                                                                    %>
                                                            </time>
                                                        </td>
                                                        <td data-label="Status">
                                                            <% if (row.status==='accepted' ) { %>
                                                                Confirmed
                                                                <% } else { %>
                                                                    <%= row.status[0].toUpperCase()+row.status.slice(1)
                                                                        %>
                                                                        <% }; %>
                                                        </td>
                                                        <td data-label="Actions">
                                                            <a class="btn custom-btn"
                                                                href="/viewbooking/<%= row.booking_id %>">More Info</a>
                                                            <a class="btn custom-btn2" data-bs-toggle="modal"
                                                                data-bs-target="#updateModal-<%= row.booking_id %>">Update
                                                                Status</a>
                                                        </td>
                                                    </tr>
                                                    <% }); %>
                                            </tbody>
                                        </table>
                                        <% }; %>
                </div>
            </div>
            <% bookings.forEach(row=> { %>
                <div class="modal fade" id="updateModal-<%= row.booking_id %>" tabindex="-1"
                    aria-labelledby="updateModalLabel-<%= row.booking_id %>" aria-hidden="true">
                    <form method="POST" action="/updatebooking/<%= row.booking_id %>">
                        <div class="modal-dialog">
                            <div class="modal-content">
                                <div class="modal-header">
                                    <h1 class="modal-title fs-5" id="updateModalLabel-<%= row.booking_id %>">Delete
                                        <%= row.title %> on <time datetime="<%= row.requested_date %>">
                                                <%= new Date(row.requested_date).toLocaleDateString('en-GB') %>
                                            </time>?
                                    </h1>
                                    <button type="button" class="btn-close" data-bs-dismiss="modal"
                                        aria-label="close"></button>
                                </div>
                                <div class="modal-body">
                                    <p class="mb-3">This will update the customers booking status.</p>
                                    <div class="dropdown">
                                        <select class="btn custom-btn4 dropdown-toggle" name="status">
                                            <option class="dropdown-item" value="" disabled>Select Status</option>
                                            <option class="dropdown-item" value="accepted" <%=row.status==='accepted'
                                                ? 'selected' : '' %>
                                                >Confirmed</option>
                                            <option class="dropdown-item" value="pending" <%=row.status==='pending'
                                                ? 'selected' : '' %>
                                                >Pending</option>
                                            <option class="dropdown-item" value="rejected" <%=row.status==='rejected'
                                                ? 'selected' : '' %>
                                                >Rejected</option>
                                        </select>
                                    </div>
                                </div>
                                <div class="modal-footer">
                                    <button type="button" class="btn custom-btn4"
                                        data-bs-dismiss="modal">Cancel</button>
                                    <button type="submit" class="btn custom-btn2">Update Status</button>
                                </div>
                            </div>
                        </div>
                    </form>
                </div>
                <% }) %>
        </div>

        <%- include('../partials/footer'); %>

            <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"
                integrity="sha384-FKyoEForCGlyvwx9Hj09JcYn3nv7wiPVlz7YYwJrWVcXK/BmnVDxM+D2scQbITxI"
                crossorigin="anonymous"></script>
</body>

</html>