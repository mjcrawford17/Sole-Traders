<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Sole Traders - Make Booking</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet"
        integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB" crossorigin="anonymous">
    <link rel="stylesheet" href="/styles/main.css" />
    <link rel="icon" type="image/png" href="/imgs/favicon.png" />
</head>

<body>
    <%- include('../partials/navbar'); %>

        <div class="container-fluid bookpg-container">
            <div class="bookpg-wrapper">
                <div class="bookpg-box">
                    <h2>Booking Page</h2>
                    <a class="back-btn btn" href="/profile/<%= service.trader_id %>">Back</a>
                    <form id="bookingform" method="post" action="/bookservice/<%= service.service_id %>">
                        <span id="availmessage"></span>
                        <input id="tradeid-input" type="hidden" name="trader_id" value="<%= service.trader_id %>">

                        <div class="acc-input">
                            <input type="text" value="<%= service.title %>" disabled />
                            <label>Service Title</label>
                        </div>

                        <div class="acc-input">
                            <input type="text" value="<%= service.description %>" disabled />
                            <label>Service Description</label>
                        </div>

                        <div class="input-box">
                            <input id="name-input" type="text" name="name" required />
                            <label for="name-input">Client Name<span id="namemessage"></span></label>
                        </div>

                        <div class="input-box">
                            <input id="email-input" type="email" name="email" required />
                            <label for="email-input">Client Email<span id="emailmessage"></span></label>
                        </div>

                        <div class="input-box">
                            <input id="description-input" type="text" name="description" required />
                            <label for="description-input">Job Description<span id="descriptionmessage"></span></label>
                        </div>

                        <div class="input-box">
                            <input id="location-input" type="text" name="location" required />
                            <label for="location-input">Job Location<span id="locationmessage"></span></label>
                        </div>

                        <div class="date-time row g-3">
                            <span id="datemessage"></span>
                            <span id="timemessage"></span>
                            <div class="col-6 col-md-3">
                                <label for="date-input" class="form-label">Requested Date</label>
                                <input id="date-input" class="form-control" type="date" name="requested_date"
                                    required />
                            </div>

                            <div class="col-6 col-md-3">
                                <label for="start-input" class="form-label">Start Time</label>
                                <input id="start-input" class="form-control" type="time" name="requested_start"
                                    required />
                            </div>

                            <div class="col-6 col-md-3">
                                <label for="end-input" class="form-label">End Time</label>
                                <input id="end-input" class="form-control" type="time" name="requested_end" required />
                            </div>
                        </div>
                        <span id="availmessage"></span>

                        <button type="submit" class="submit-btn">Add</button>

                    </form>
                </div>
            </div>
        </div>

        <%- include('../partials/footer'); %>

            <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"
                integrity="sha384-FKyoEForCGlyvwx9Hj09JcYn3nv7wiPVlz7YYwJrWVcXK/BmnVDxM+D2scQbITxI"
                crossorigin="anonymous"></script>

            <script src="/js/bookingvalidation.js"></script>

            <% if (errors) { %>
                <script>

                    const errorDataJSON = `<%- JSON.stringify(errors) %>`;
                    const errorData = JSON.parse(errorDataJSON);

                    errorData.forEach((error) => {

                        if (error.path === 'name') {
                            const msgElement = document.getElementById('namemessage');
                            fadeMessage(msgElement, error.msg);
                        }

                        if (error.path === 'email') {
                            const msgElement = document.getElementById('emailmessage');
                            fadeMessage(msgElement, error.msg);
                        }

                        if (error.path === 'description') {
                            const msgElement = document.getElementById('descriptionmessage');
                            fadeMessage(msgElement, error.msg);
                        }

                        if (error.path === 'location') {
                            const msgElement = document.getElementById('locationmessage');
                            fadeMessage(msgElement, error.msg);
                        }

                        if (error.path === 'requested_date') {
                            const msgElement = document.getElementById('datemessage');
                            fadeMessage(msgElement, error.msg);
                        }

                        if (error.path === 'requested_start' || error.path === 'requested_end') {
                            const msgElement = document.getElementById('timemessage');
                            fadeMessage(msgElement, error.msg);
                        }

                        if (error.path === 'avail') {
                            const msgElement = document.getElementById('availmessage');
                            fadeMessage(msgElement, error.msg);
                        }

                    });
                </script>
                <% }; %>
</body>

</html>