<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Sole Traders - Booking Details</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet"
        integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB" crossorigin="anonymous">
    <link rel="stylesheet" href="/styles/main.css" />
    <link rel="icon" type="image/png" href="/imgs/favicon.png" />
</head>

<body>
    <%- include('../partials/navbar'); %>

        <div class="container-fluid booking-container">
            <div class="booking-wrapper">
                <div class="booking-box">
                    <h2>Full Booking Details</h2>
                    <a class="back-btn btn" href="/bookings">Back</a>
                    <div class="booking-input">
                        <p>
                            <%= bookings.client_name %>
                        </p>
                        <label>Client Name</label>
                    </div>

                    <div class="booking-input">
                        <p>
                            <%= bookings.client_email %>
                        </p>
                        <label>Client Email</label>
                    </div>

                    <div class="booking-input">
                        <p>
                            <%= bookings.title %>
                        </p>
                        <label>Service Title</label>
                    </div>

                    <div class="booking-input">
                        <p>
                            <%= bookings.job_description %>
                        </p>
                        <label>Client Description</label>
                    </div>

                    <div class="booking-input">
                        <p>
                            <%= bookings.job_location %>
                        </p>
                        <label>Job Location</label>
                    </div>

                    <div class="booking-input">
                        <time datetime="<%= bookings.requested_date %>">
                            <%= new Date(bookings.requested_date).toLocaleDateString('en-GB') %>
                        </time>
                        <label>Requested Date</label>
                    </div>

                    <div class="booking-input">
                        <time datetime="<%= bookings.requested_start_time %>">
                            <%= String(bookings.requested_start_time).slice(0,5) %>
                        </time>
                        <label>Requested Start Time</label>
                    </div>

                    <div class="booking-input">
                        <time datetime="<%= bookings.requested_end_time %>">
                            <%= String(bookings.requested_end_time).slice(0,5) %>
                        </time>
                        <label>Requested End Time</label>
                    </div>

                    <div class="booking-input">
                        <p>
                            <%= bookings.status[0].toUpperCase()+bookings.status.slice(1) %>
                        </p>
                        <label>Status</label>
                    </div>

                    <div class="booking-input">
                        <time datetime="<%= bookings.created_at %>">
                            <%= new Date(bookings.created_at).toLocaleDateString('en-GB') %>
                        </time>
                        <label>Booking Date</label>
                    </div>

                </div>
            </div>
        </div>

        <%- include('../partials/footer'); %>

            <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"
                integrity="sha384-FKyoEForCGlyvwx9Hj09JcYn3nv7wiPVlz7YYwJrWVcXK/BmnVDxM+D2scQbITxI"
                crossorigin="anonymous"></script>
</body>

</html>