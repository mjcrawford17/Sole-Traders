<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Sole Traders - Traders</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet"
    integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB" crossorigin="anonymous">
  <link rel="stylesheet" href="/styles/main.css" />
  <link rel="icon" type="image/png" href="/imgs/favicon.png">
</head>

<body>

  <%- include('../partials/navbar'); %>

    <div class="container-fluid traderspg-container">


      <h1 class="traders-title">Listed Traders</h1>

      <div class="w-100 d-flex justify-content-end mb-3 filter-wrap">
        <form class="m-0" method="GET" action="/traders">

          <div class="row filter-bar g-2 align-items-center">

            <div class="col-auto">
              <select name="trade" class="trade-select">
                <option value="">Trader Type</option>
                <% tradeTypes.forEach((row)=> { %>
                  <option value="<%= row.trade_type %>">
                    <%= row.trade_type %>
                  </option>
                  <% }) %>
              </select>
            </div>

            <div class="col-auto">
              <input type="text" class="location-input form-control" name="location" placeholder="Location"
                aria-label="Location">
            </div>

            <div class="col-auto">
              <button type="submit" class="btn tr-submit-btn">Go</button>
            </div>

          </div>
        </form>
      </div>

      <div class="container traders-grid flex-fill">
        <div class="row g-4 justify-content-center">
          <% if (!traders || traders.length===0) { %>
            <p class="text-center text-muted mt-3">
              No Traders currently available. Try again soon!
            </p>
            <% } %>
          <% traders.forEach((row)=> { %>
            <div class="col-12 col-sm-6 col-lg-3">
              <a href="/profile/<%= row.trader_id %>" class="trader-link">
                <div class="trader-tab h-100 text-center">
                  <h6 class="mb-1">
                    <%= row.full_name %>
                  </h6>
                  <small>
                    <%= row.trade_type %>
                  </small>
                  <small class="text-muted">
                    <%= row.region_town %>
                  </small>
                  <small>
                    <svg xmlns="http://www.w3.org/2000/svg" height="16px" viewBox="0 -960 960 960" width="16px" fill="#000000"><path d="m384-334 96-74 96 74-36-122 90-64H518l-38-124-38 124H330l90 64-36 122ZM233-120l93-304L80-600h304l96-320 96 320h304L634-424l93 304-247-188-247 188Zm247-369Z"/></svg>
                    <% if (row.avg_rating) {%>
                      <%= row.avg_rating %>
                    <% } else { %>
                      No rating
                    <% }; %>
                    <svg xmlns="http://www.w3.org/2000/svg" height="16px" viewBox="0 -960 960 960" width="16px" fill="#000000"><path d="m384-334 96-74 96 74-36-122 90-64H518l-38-124-38 124H330l90 64-36 122ZM233-120l93-304L80-600h304l96-320 96 320h304L634-424l93 304-247-188-247 188Zm247-369Z"/></svg>
                  </small>
                </div>
              </a>
            </div>
            <% }); %>
        </div>
      </div>
    </div>

    <%- include('../partials/footer'); %>
      <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"
        integrity="sha384-FKyoEForCGlyvwx9Hj09JcYn3nv7wiPVlz7YYwJrWVcXK/BmnVDxM+D2scQbITxI"
        crossorigin="anonymous"></script>
</body>

</html>