<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Sole Traders - Trader Account</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet"
    integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB" crossorigin="anonymous">
  <link rel="stylesheet" href="/styles/main.css" />
  <link rel="icon" type="image/png" href="/imgs/favicon.png" />
</head>

<body>
  <%- include('../partials/navbar'); %>

    <div class="container-fluid account-container">
      <div class="account-wrapper">
        <div class="account-box">
          <h2>Account Dashboard</h2>

          <div class="acc-input">
            <input type="text" name="name" placeholder="<%= trader.full_name %>" disabled />
            <label>Full Name</label>
          </div>

          <div class="acc-input">
            <input type="text" name="username" placeholder="<%= trader.username %>" disabled />
            <label>Username</label>
          </div>

          <div class="acc-input">
            <input type="email" name="email" placeholder="<%= trader.email_address %>" disabled />
            <label>Email</label>
          </div>

          <div class="acc-input">
            <input type="text" name="trade_type" placeholder="<%= trader.trade_type %>" disabled />
            <label>Trade Type</label>
          </div>

          <div class="acc-input">
            <input type="text" name="region" placeholder="<%= trader.region_town %>" disabled />
            <label>Region/Town</label>
          </div>

          <div class="acc-input">
            <input type="text" name="bio" placeholder="<%= trader.bio %>" disabled />
            <label>Bio</label>
          </div>

          <div class="date-time row g-3">
            <label>Availability</label>

            <div class="col-6 col-md-3">
              <label class="form-label">Start Time</label>
              <input class="form-control" type="time" name="avail_start" value="<%= trader.availability_start_time %>" disabled />
            </div>

            <div class="col-6 col-md-3">
              <label class="form-label">End Time</label>
              <input class="form-control" type="time" name="avail_end" value="<%= trader.availability_end_time %>" disabled />
            </div>
          </div>

          <div class="acc-input">
            <input type="text" name="avail_details" placeholder="<%= trader.availability_details !== '' ? trader.availability_details : 'No details gave!' %>" disabled/>
            <label>Availability Details</label>
          </div>

          <a href="/editaccount"><button type="button" class="submit-btn">Edit</button></a>

        </div>
      </div>
    </div>

    <%- include('../partials/footer'); %>

      <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"
        integrity="sha384-FKyoEForCGlyvwx9Hj09JcYn3nv7wiPVlz7YYwJrWVcXK/BmnVDxM+D2scQbITxI"
        crossorigin="anonymous"></script>
</body>

</html>