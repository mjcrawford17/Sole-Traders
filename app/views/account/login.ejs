<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Sole Traders - Login</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet"
        integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB" crossorigin="anonymous">
    <link rel="stylesheet" href="/styles/main.css" />
    <link rel="icon" type="image/png" href="/imgs/favicon.png" />
</head>

<body>
    <%- include('../partials/navbar'); %>

        <div class="container-fluid login-container">
            <div class="wrapper">
                <div class="form-box login-page">
                    <form id="loginform" method="post" action="/login">
                        <h2>Login</h2>
                        <div class="input-box">
                            <span class="icon"><svg xmlns="http://www.w3.org/2000/svg" height="20px"
                                    viewBox="0 -960 960 960" width="20px" fill="#000000">
                                    <path
                                        d="M160-160q-33 0-56.5-23.5T80-240v-480q0-33 23.5-56.5T160-800h640q33 0 56.5 23.5T880-720v480q0 33-23.5 56.5T800-160H160Zm320-280L160-640v400h640v-400L480-440Zm0-80 320-200H160l320 200ZM160-640v-80 480-400Z" />
                                </svg></span>
                            <input type="text" name="username" id="username-input" required />
                            <label for="username-input">Username<span id="usermessage"></span></label>
                        </div>
                        <div class="input-box">
                            <span class="icon"><svg xmlns="http://www.w3.org/2000/svg" height="20px"
                                    viewBox="0 -960 960 960" width="20px" fill="#000000">
                                    <path
                                        d="M240-80q-33 0-56.5-23.5T160-160v-400q0-33 23.5-56.5T240-640h40v-80q0-83 58.5-141.5T480-920q83 0 141.5 58.5T680-720v80h40q33 0 56.5 23.5T800-560v400q0 33-23.5 56.5T720-80H240Zm0-80h480v-400H240v400Zm240-120q33 0 56.5-23.5T560-360q0-33-23.5-56.5T480-440q-33 0-56.5 23.5T400-360q0 33 23.5 56.5T480-280ZM360-640h240v-80q0-50-35-85t-85-35q-50 0-85 35t-35 85v80ZM240-160v-400 400Z" />
                                </svg></span>
                            <input type="password" name="userpass" id="password-input" required />
                            <label for="password-input">Password<span id="passmessage"></span></label>
                        </div>
                        <div class="remember-forgot">
                            <label><input type="checkbox" /> Remember me</label>
                            <a href="#">Forgot Password?</a>
                        </div>
                        <button type="submit" class="submit-btn" value="Login">Login</button>
                        <div class="login-register">
                            <p>
                                Don't have an account?
                                <a href="#register" class="register-link">Register</a>
                            </p>
                        </div>
                    </form>
                </div>

                <div class="form-box register">
                    <h2>Registration</h2>
                    <form id="registrationform" method="post" action="/register">
                        <div class="input-box">
                            <span class="icon"><svg xmlns="http://www.w3.org/2000/svg" height="20px"
                                    viewBox="0 -960 960 960" width="20px" fill="#000000">
                                    <path
                                        d="M160-80q-33 0-56.5-23.5T80-160v-440q0-33 23.5-56.5T160-680h200v-120q0-33 23.5-56.5T440-880h80q33 0 56.5 23.5T600-800v120h200q33 0 56.5 23.5T880-600v440q0 33-23.5 56.5T800-80H160Zm0-80h640v-440H600q0 33-23.5 56.5T520-520h-80q-33 0-56.5-23.5T360-600H160v440Zm80-80h240v-18q0-17-9.5-31.5T444-312q-20-9-40.5-13.5T360-330q-23 0-43.5 4.5T276-312q-17 8-26.5 22.5T240-258v18Zm320-60h160v-60H560v60Zm-200-60q25 0 42.5-17.5T420-420q0-25-17.5-42.5T360-480q-25 0-42.5 17.5T300-420q0 25 17.5 42.5T360-360Zm200-60h160v-60H560v60ZM440-600h80v-200h-80v200Zm40 220Z" />
                                </svg></span>
                            <input type="text" name="fullname" id="fullname-reg-input" required />
                            <label for="fullname-reg-input">Full Name<span id="namemessage"></span></label>
                        </div>
                        <div class="input-box">
                            <span class="icon"><svg xmlns="http://www.w3.org/2000/svg" height="20px"
                                    viewBox="0 -960 960 960" width="20px" fill="#000000">
                                    <path
                                        d="M234-276q51-39 114-61.5T480-360q69 0 132 22.5T726-276q35-41 54.5-93T800-480q0-133-93.5-226.5T480-800q-133 0-226.5 93.5T160-480q0 59 19.5 111t54.5 93Zm246-164q-59 0-99.5-40.5T340-580q0-59 40.5-99.5T480-720q59 0 99.5 40.5T620-580q0 59-40.5 99.5T480-440Zm0 360q-83 0-156-31.5T197-197q-54-54-85.5-127T80-480q0-83 31.5-156T197-763q54-54 127-85.5T480-880q83 0 156 31.5T763-763q54 54 85.5 127T880-480q0 83-31.5 156T763-197q-54 54-127 85.5T480-80Zm0-80q53 0 100-15.5t86-44.5q-39-29-86-44.5T480-280q-53 0-100 15.5T294-220q39 29 86 44.5T480-160Zm0-360q26 0 43-17t17-43q0-26-17-43t-43-17q-26 0-43 17t-17 43q0 26 17 43t43 17Zm0-60Zm0 360Z" />
                                </svg></span>
                            <input type="text" name="usernamereg" id="username-reg-input" required />
                            <label for="username-reg-input">Username<span id="usernamemessage"></span></label>
                        </div>
                        <div class="input-box">
                            <span class="icon"><svg xmlns="http://www.w3.org/2000/svg" height="20px"
                                    viewBox="0 -960 960 960" width="20px" fill="#000000">
                                    <path
                                        d="M160-160q-33 0-56.5-23.5T80-240v-480q0-33 23.5-56.5T160-800h640q33 0 56.5 23.5T880-720v480q0 33-23.5 56.5T800-160H160Zm320-280L160-640v400h640v-400L480-440Zm0-80 320-200H160l320 200ZM160-640v-80 480-400Z" />
                                </svg></span>
                            <input type="email" name="email" id="email-reg-input" required />
                            <label for="email-reg-input">Email<span id="emailmessage"></span></label>
                        </div>
                        <div class="input-box">
                            <span class="icon"><svg xmlns="http://www.w3.org/2000/svg" height="20px"
                                    viewBox="0 -960 960 960" width="20px" fill="#000000">
                                    <path
                                        d="M240-80q-33 0-56.5-23.5T160-160v-400q0-33 23.5-56.5T240-640h40v-80q0-83 58.5-141.5T480-920q83 0 141.5 58.5T680-720v80h40q33 0 56.5 23.5T800-560v400q0 33-23.5 56.5T720-80H240Zm0-80h480v-400H240v400Zm240-120q33 0 56.5-23.5T560-360q0-33-23.5-56.5T480-440q-33 0-56.5 23.5T400-360q0 33 23.5 56.5T480-280ZM360-640h240v-80q0-50-35-85t-85-35q-50 0-85 35t-35 85v80ZM240-160v-400 400Z" />
                                </svg></span>
                            <input type="password" name="userpassreg" id="password-reg-input" required />
                            <label for="password-reg-input">Password<span id="passwordmessage"></span></label>
                        </div>
                        <div class="remember-forgot">
                            <label><input type="checkbox" required /> I agree to the <a href="/terms">terms & conditions</a></label>
                        </div>
                        <button type="submit" class="submit-btn">Register</button>
                        <div class="login-register">
                            <p>
                                Already have an account? <a href="#" class="login-link">Login</a>
                            </p>
                        </div>
                    </form>
                </div>
            </div>
        </div>

        <%- include('../partials/footer'); %>

            <script>
                const wrapper = document.querySelector(".wrapper");
                const loginLink = document.querySelector(".login-link");
                const registerLink = document.querySelector(".register-link");


                function handleHash() {
                    if (window.location.hash === "#register") {
                        wrapper.classList.add("active");
                        document.title = "Sole Traders - Register";
                    } else {
                        wrapper.classList.remove("active");
                        document.title = "Sole Traders - Login";
                    }
                }

                handleHash();

                window.addEventListener("hashchange", handleHash);

                registerLink.addEventListener("click", () => {
                    window.location.hash = "register";
                });

                loginLink.addEventListener("click", () => {
                    window.location.hash = "";
                });
            </script>

            <script src="/js/loginvalidation.js"></script>

            <% if (errors) { %>
                <script>

                    const errorDataJSON = `<%- JSON.stringify(errors) %>`;
                    const errorData = JSON.parse(errorDataJSON);

                    errorData.forEach((error) => {

                        if (error.path === 'username') {
                            const msgElement = document.getElementById('usermessage');
                            fadeMessage(msgElement, error.msg);
                        }

                        if (error.path === 'userpass') {
                            const msgElement = document.getElementById('passmessage');
                            fadeMessage(msgElement, error.msg);
                        }

                    });

                </script>
                <% }; %>

                    <script src="/js/registrationvalidation.js"></script>

                    <% if (errorsreg) { %>
                        <script>

                            const errorRegDataJSON = `<%- JSON.stringify(errorsreg) %>`;
                            const errorRegData = JSON.parse(errorRegDataJSON);

                            errorRegData.forEach((error) => {

                                if (error.path === 'usernamereg') {
                                    const msgElement = document.getElementById('usernamemessage');
                                    fadeMessage(msgElement, error.msg);
                                }

                                if (error.path === 'userpassreg') {
                                    const msgElement = document.getElementById('passwordmessage');
                                    fadeMessage(msgElement, error.msg);
                                }

                                if (error.path === 'email') {
                                    const msgElement = document.getElementById('emailmessage');
                                    fadeMessage(msgElement, error.msg);
                                }

                                if (error.path === 'fullname') {
                                    const msgElement = document.getElementById('namemessage');
                                    fadeMessage(msgElement, error.msg);
                                }

                            });

                        </script>
                        <% } %>

                            <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"
                                integrity="sha384-FKyoEForCGlyvwx9Hj09JcYn3nv7wiPVlz7YYwJrWVcXK/BmnVDxM+D2scQbITxI"
                                crossorigin="anonymous"></script>
</body>

</html>