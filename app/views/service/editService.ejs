<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Sole Traders - Edit Service</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet"
        integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB" crossorigin="anonymous">
    <link rel="stylesheet" href="/styles/main.css" />
    <link rel="icon" type="image/png" href="/imgs/favicon.png" />
</head>

<body>
    <%- include('../partials/navbar'); %>

        <div class="container-fluid setup-container">
            <div class="setup-wrapper">
                <div class="setup-box">
                    <h2>Edit Service</h2>
                    <a class="back-btn btn" href="/services">Back</a>
                    <form id="servicesform" method="post" action="/editservice/<%= services.service_id %>">

                        <div class="acc-input">
                            <input id="title-input" type="text" name="title" value="<%= services.title %>" required />
                            <label for="title-input">Title<span id="titlemessage"></span></label>
                        </div>

                        <div class="acc-input">
                            <input id="description-input" type="text" name="description"
                                value="<%= services.description %>" required/>
                            <label for="description-input">Description<span id="descriptionmessage"></span></label>
                        </div>

                        <div class="acc-input">
                            <select id="pricetype-input" name="pricing_type" class="select" required>
                                <option value="">Pricing Type</option>
                                <option value="hourly" <%=services.pricing_type==='hourly' ? 'selected' : '' %>>
                                    Hourly
                                </option>
                                <option value="fixed" <%=services.pricing_type==='fixed' ? 'selected' : '' %>>
                                    Fixed
                                </option>
                            </select>
                            <label for="pricetype-input">Pricing Type<span id="pricemessage"></span></label>
                        </div>

                        <div class="acc-input">
                            <input id="baseprice-input" type="number" name="base_price"
                                value="<%= services.base_price %>" required />
                            <label for="baseprice-input">Base Price<span id="basepricemessage"></span></label>
                        </div>

                        <button type="submit" class="submit-btn">Submit</button>

                    </form>

                </div>
            </div>
        </div>

        <%- include('../partials/footer'); %>

            <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"
                integrity="sha384-FKyoEForCGlyvwx9Hj09JcYn3nv7wiPVlz7YYwJrWVcXK/BmnVDxM+D2scQbITxI"
                crossorigin="anonymous"></script>

            <script src="/js/servicesvalidation.js"></script>

            <% if (errors) { %>
                <script>

                    const errorDataJSON = `<%- JSON.stringify(errors) %>`;
                    const errorData = JSON.parse(errorDataJSON);

                    errorData.forEach((error) => {

                        if (error.path === 'title') {
                            const msgElement = document.getElementById('titlemessage');
                            fadeMessage(msgElement, error.msg);
                        }

                        if (error.path === 'description') {
                            const msgElement = document.getElementById('descriptionmessage');
                            fadeMessage(msgElement, error.msg);
                        }

                        if (error.path === 'pricing_type') {
                            const msgElement = document.getElementById('pricemessage');
                            fadeMessage(msgElement, error.msg);
                        }

                        if (error.path === 'base_price') {
                            const msgElement = document.getElementById('basepricemessage');
                            fadeMessage(msgElement, error.msg);
                        }

                    });
                </script>
                <% }; %>
</body>

</html>